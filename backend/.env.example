# OpenAI: lead scoring (structured output) and follow-up drafting
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Postgres: leads, scoring history, drafts/approval state, trace events
DATABASE_URL=postgresql://funneltrace:funneltrace@localhost:5433/funneltrace

# HubSpot (free-tier sandbox) private app token, used by the one real CRM adapter
HUBSPOT_ACCESS_TOKEN=

# Comma-separated browser origins allowed to call the API (the Next.js UI)
FRONTEND_ORIGINS=http://localhost:3000

# Model that writes the follow-up replies (default gpt-5.4-mini); scoring uses OPENAI_MODEL
OPENAI_DRAFT_MODEL=
